{
  "name": "graf-flow-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node dist/server/server.js",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "serve:site": "npm run build:site && node scripts/serve-site.mjs",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc",
    "lint:flow": "npm run build && node dist/tools/flow-lint.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.19.2",
    "roughjs": "^4.6.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
