{
  "name": "grafd-ai",
  "version": "0.1.3",
  "description": "Freeform web canvas editor for .flow files",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "grafd": "dist/cli-main.js"
  },
  "files": [
    "dist",
    "public",
    "SAVE-GUIDE.md",
    "FLOW-SPEC.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txchin0/grafd.git"
  },
  "keywords": [
    "flow",
    "diagram",
    "canvas",
    "editor"
  ],
  "scripts": {
    "start": "npm run build && node dist/server/server-main.js .grafd",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "serve:site": "npm run build:site && node scripts/serve-site.mjs",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc",
    "lint:flow": "node scripts/clean.mjs .lint-build && tsc -p tsconfig.lint.json && node .lint-build/tools/flow-lint-main.js",
    "import:theme": "npm run build && node dist/tools/theme-import.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.19.2",
    "roughjs": "^4.6.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
